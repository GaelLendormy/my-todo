{
  "name": "my-todo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc --project tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "check:persistence": "tsx scripts/check-persistence.ts",
    "check:recovery": "tsx scripts/check-recovery.ts"
  },
  "dependencies": {
    "nuxt": "4.4.2",
    "vue": "3.5.45",
    "drizzle-orm": "0.45.4",
    "better-sqlite3": "12.8.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.15.2",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.12.0",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.6",
    "vitest": "4.0.18",
    "tsx": "4.21.0"
  },
  "pnpm": {
    "overrides": {
      "@nuxt/kit": "4.4.2",
      "@nuxt/cli": "3.34.0",
      "@nuxt/devtools": "3.2.3"
    }
  }
}
